{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "r2h-pdf",
  "version": "2.1.0",
  "identifier": "com.relat.r2h-pdf",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "r2h-pdf",
        "width": 1280,
        "height": 800,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: https://ipc.localhost data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "licenseFile": "../release/EULA.txt",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
